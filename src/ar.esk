// <ar>: augmented reality for apps on eskiu-lang/ui, over ARKit on iOS and ARCore on
// Android. use_ar_session runs a world-tracking session while its scope is mounted and hands
// each new frame to Eskiu on the UI thread: the camera picture as YUV planes (the layout of
// ui-camera's CameraFrame, which eskiu-gpu's <gpu/yuv> draws), the camera's pose and
// intrinsics, planes, anchors, image targets, feature points, the light estimate and depth.
// The geometry (view, projection, display transform, hit-test ray) is computed in <ar/math>,
// the same on every platform. On the web the session is WebXR's immersive-ar (Chrome on Android), where
// the browser draws the camera itself (frame.has_image) and other browsers report
// ArUnsupported.
import <string>;
import <list>;
import <ui>;
import <ar/math>;

// Where the session is: starting (asking for the camera, installing ARCore), running, or
// why it is not: the device has no AR (or it is the simulator, or a browser without WebXR
// AR), the camera permission is denied, ARCore is being installed (the session starts when
// it is), it failed, it is paused while the app is in the background, or (the web) the
// browser waits for a tap: it starts an immersive session only from one, and the next tap
// anywhere on the page starts it.
enum ArStatus { ArStarting, ArRunning, ArUnsupported, ArDenied, ArInstalling, ArFailed, ArPaused, ArWaitingForTap }

// How well the camera is tracked: not at all (its pose means nothing), limited (the pose is
// rough; `reason` says why), or normal.
enum ArTracking { ArTrackingNone, ArTrackingLimited, ArTrackingNormal }

// Why tracking is limited: none, starting up, the device moves too fast, too few features
// (a blank wall), too dark, finding its place again after an interruption, the camera is
// unavailable, or an internal error.
enum ArReason {
    ArReasonNone,
    ArReasonInitializing,
    ArReasonExcessiveMotion,
    ArReasonInsufficientFeatures,
    ArReasonInsufficientLight,
    ArReasonRelocalizing,
    ArReasonCameraUnavailable,
    ArReasonBadState
}

// Which way a plane faces: horizontal facing up (a floor, a table), horizontal facing down
// (a ceiling), or vertical (a wall).
enum ArAlignment { ArHorizontalUp, ArHorizontalDown, ArVertical }

// What a depth image holds: 32-bit floats in meters (ARKit's LiDAR) or 16-bit unsigned
// millimeters (ARCore).
enum ArDepthFormat { ArDepthMeters32, ArDepthMillimeters16 }

// Where the depth image comes from: the device's sensor where it has one, else a depth
// model (ArOptions.depth_model); the sensor only; or the model even on a device with a sensor.
enum ArDepthSource { ArDepthSourceAuto, ArDepthSourceSensor, ArDepthSourceModel }

// Hit-test targets, combined with |: planes found so far (inside their outline), and
// estimates (ARKit's estimated planes, ARCore's feature and depth points).
const int AR_HIT_PLANES = 1;
const int AR_HIT_ESTIMATED = 2;

// Hit kinds in ArHit.kind.
const int AR_HIT_PLANE = 1;
const int AR_HIT_ESTIMATE = 2;
// A hit on the depth image (ArFrame_depth_hit): a real surface where no plane was found.
const int AR_HIT_DEPTH = 3;

// How the pixels of an ArImageTarget are laid out: one 8-bit gray value each, or 8-bit red,
// green, blue and alpha.
enum ArPixelFormat { ArPixelsGray8, ArPixelsRGBA8 }

// A picture for the session to find in the world (a poster, a cover, a label): its `name`,
// either its pixels (`width` x `height` in `format`, `row_stride` bytes from one row to the
// next, 0 for tight rows) or a PNG or JPEG file at `path` (a file of the app's assets/, as
// ui_asset_path finds it, or an absolute path; a URL on the web), and how wide it is in the
// world, in meters (needed: ARKit takes no image without it, and ARCore finds the image's
// pose sooner with it). The platforms track the image's features in gray: give it detail and
// contrast (ar_image_state says when one is refused). Copied when the session gets it.
struct ArImageTarget {
    string name;
    *uint8 pixels;
    int width;
    int height;
    int format;
    int row_stride;
    string path;
    float physical_width;
}

// What use_ar_session asks for: plane detection (horizontal, vertical), the light estimate
// (`light_hdr` asks ARCore for its environmental HDR estimate instead: main light and
// spherical harmonics; iOS ignores it), depth where the device has it (LiDAR on iOS, the
// Depth API on Android) or from `depth_model` (iOS: a CoreML depth model, Depth Anything V2
// metric, run on the picture where there is no LiDAR, or always with `depth_source`), the
// people's depth over it (`people`, iOS), ARCore's cloud anchors (`cloud_anchors`) and
// Earth (`geospatial`: frame.earth and anchors at places on Earth) on Android, which need
// the app's Google Cloud API key, the reconstructed mesh of the surroundings
// (`mesh`, LiDAR), the feature points, the size of the camera picture (a wish: the
// platform gives the nearest it has, as the sensor sees it, landscape), and image targets:
// `image_count` pictures at `images` to find (frame.images), of which ARKit follows
// `tracked_images` as they move (the others keep the pose where they were last seen; ARCore
// follows every one). The targets are copied when they change: a new array, count or field.
struct ArOptions {
    bool horizontal = true;
    bool vertical = false;
    bool light = true;
    bool light_hdr = false;
    bool depth = false;
    bool people = false;
    bool mesh = false;
    string depth_model;
    int depth_source = ArDepthSourceAuto;
    bool cloud_anchors = false;
    bool geospatial = false;
    bool points = false;
    int image_width = 1280;
    int image_height = 720;
    *ArImageTarget images;
    int image_count;
    int tracked_images = 1;
}

// One plane of the camera picture: `data` (borrowed for the handler's call), the bytes from
// one row to the next, from one sample to the next in a row, and the bytes readable from
// `data`. The layout of ui-camera's CameraPlane and eskiu-gpu's GpuYuvPlane.
struct ArImagePlane { *uint8 data; int row_stride; int pixel_stride; int64 size; }

// The camera picture, with the field layout of ui-camera's CameraFrame and eskiu-gpu's
// GpuYuvImage, so `(*GpuYuvImage)&frame.image` uploads it: size, format (0 NV12 on iOS and
// Android, 4 RGBA in one plane on the web with WebXR raw camera access; 1 NV21, 2 I420 and
// 3 three-plane YUV are the layouts CameraFrame also knows), the planes, how far to turn it
// clockwise to be upright on the screen, the capture time, and its YUV matrix (0 BT.601)
// and range.
struct ArCameraImage {
    int width;
    int height;
    int format;
    int plane_count;
    ArImagePlane[3] planes;
    int rotation;
    int64 timestamp_ns;
    bool front;
    int matrix;
    bool full_range;
}

// A detected plane: an id that stays the same while it is tracked, its alignment, how well
// it is tracked, its center pose (y along the plane's normal), its size along the pose's x
// and z, its outline (`polygon_count` points in the pose's x-z plane, borrowed for the
// handler's call), the id of the plane that took it over (0 while it stands alone), and
// what it is (an ArPlaneClass: floor, table, wall...; ARKit classifies, ARCore does not, and
// WebXR does where the browser labels planes).
struct ArPlane {
    int64 id;
    int alignment;
    int tracking;
    ArMat4 pose;
    float extent_x;
    float extent_z;
    *ArVec2 polygon;
    int polygon_count;
    int64 subsumed_by;
    int classification;
}

// What a plane is (ArPlane.classification), ARKit's ARPlaneClassification: not known, a wall,
// the floor, the ceiling, a table, a seat, a window or a door.
enum ArPlaneClass { ArPlaneNone, ArPlaneWall, ArPlaneFloor, ArPlaneCeiling, ArPlaneTable, ArPlaneSeat, ArPlaneWindow, ArPlaneDoor }

// An anchor the app added: its id, how well it is tracked, and its pose, which the session
// updates as it learns more about the world.
struct ArAnchor { int64 id; int tracking; ArMat4 pose; }

// A feature point in world space and the platform's confidence in it (0 to 1; 1 on iOS).
struct ArPoint { ArVec3 position; float confidence; }

// Where a light estimate comes from: none, ARKit (ambient intensity in lumens and a color
// temperature), ARCore's ambient intensity mode (pixel intensity and color correction in
// gamma space), ARCore's environmental HDR mode, or WebXR's light probe.
enum ArLightSource { ArLightNone, ArLightARKit, ArLightARCore, ArLightARCoreHdr, ArLightWebXR }

// The light estimate, on one scale on every platform. `intensity` is a linear multiplier,
// 1.0 in a neutral scene: ARKit's ambient intensity over 1000 (its neutral), ARCore's pixel
// intensity taken to linear space and over middle gray (ar_light_from_arcore). `color` is a
// linear RGB tint to multiply lighting by, green 1 on ARCore (its color correction, taken to
// linear space), from `temperature` (kelvin, ARKit; 6500 elsewhere) on iOS. `raw_intensity`
// is the platform's own value (lumens, or ARCore's gamma pixel intensity) and `source` says
// which (an ArLightSource). With ARCore's environmental HDR mode (and WebXR's light probe)
// `intensity` is 1.0 and the light is the main light's direction (toward the light) and
// linear RGB intensity, and 9 RGB spherical harmonics coefficients of the ambient light, in
// the platform's order and scale.
struct ArLight {
    bool valid;
    float intensity;
    float temperature;
    ArVec3 color;
    bool has_main;
    ArVec3 main_direction;
    ArVec3 main_intensity;
    bool has_harmonics;
    float[27] harmonics;
    float raw_intensity;
    int source;
}

// Where the device is on Earth (ArOptions.geospatial, ARCore on Android): whether Earth is
// enabled (`state` 0; ARCore's ArEarthState otherwise: not authorized, resources exhausted...)
// and how well it is tracked, then the camera's geospatial pose once tracking: latitude and
// longitude in degrees (WGS84), altitude in meters above the WGS84 ellipsoid, their
// accuracies in meters, its rotation as an east-up-south quaternion and the yaw's accuracy in
// degrees.
struct ArEarth {
    int state;
    int tracking;
    double latitude;
    double longitude;
    double altitude;
    double horizontal_accuracy;
    double vertical_accuracy;
    float[4] rotation;
    double yaw_accuracy;
}

// A depth image, aligned with the camera picture (as the sensor gives it, often smaller):
// size, format (ArDepthFormat), the bytes from one row to the next, and `data`, borrowed for
// the handler's call (null when there is no depth); `estimated` when a depth model made it
// from the picture (ArOptions.depth_model) instead of a sensor measuring it.
struct ArDepth { int width; int height; int format; int row_stride; *uint8 data; int64 size; bool estimated; }

// One hit-test result: the distance from the camera, the kind (AR_HIT_PLANE or
// AR_HIT_ESTIMATE), the plane hit (0 for an estimate) and the pose of the hit (y along the
// surface's normal).
struct ArHit { float distance; int kind; int64 plane; ArMat4 pose; }

// How an image target is followed: not at all, fully (its pose follows the picture as it
// moves), or at the pose where it was last seen (it is out of view, or ARKit follows other
// images: ArOptions.tracked_images).
enum ArImageMethod { ArImageNotTracking, ArImageFull, ArImageLastKnown }

// Where an image target stands: being prepared, ready to be found, or refused (no pixels or
// file, a file that does not decode, no physical width, or too few features to track).
enum ArImageState { ArImagePending, ArImageReady, ArImageRejected }

// An image target found in the world: an id that stays while it is known, the index of its
// ArImageTarget in ArOptions.images and its name (borrowed for the handler's call), how well
// it is tracked (an ArTracking) and how (an ArImageMethod), the pose of its center (x to the
// picture's right, z toward its bottom, y out of its face) and its size in meters along x
// and z, as the platform estimates it.
struct ArTrackedImage {
    int64 id;
    int index;
    string name;
    int tracking;
    int method;
    ArMat4 pose;
    float extent_x;
    float extent_z;
}

// A piece of the world's mesh (LiDAR scene reconstruction on iOS, ArOptions.mesh): an id
// that stays while it is tracked, its pose, and its triangles in the pose's space, borrowed
// for the handler's call from where ARKit keeps them: `vertex_count` positions (3 floats
// each, `vertex_stride` bytes apart), as many normals (`normal_stride` apart) and
// `face_count` triangles of three indices (`index_bytes` 2 or 4 each). A piece grows and
// changes as the device sees more: its arrays may differ from one frame to the next.
struct ArMesh {
    int64 id;
    ArMat4 pose;
    *uint8 vertices;
    int vertex_count;
    int vertex_stride;
    *uint8 normals;
    int normal_stride;
    *uint8 faces;
    int face_count;
    int index_bytes;
}

// Vertex i of a mesh, in its pose's space.
ArVec3 ArMesh_vertex(*ArMesh self, int i) {
    *float p = (*float)(self.vertices + (int64)i * self.vertex_stride);
    return ArVec3{p[0], p[1], p[2]};
}

// Normal i of a mesh.
ArVec3 ArMesh_normal(*ArMesh self, int i) {
    *float p = (*float)(self.normals + (int64)i * self.normal_stride);
    return ArVec3{p[0], p[1], p[2]};
}

// Index k (0 to 3 * face_count) of a mesh's triangles.
int ArMesh_index(*ArMesh self, int k) {
    if (self.index_bytes == 2) return (int)((*uint16)self.faces)[k];
    return (int)((*uint32)self.faces)[k];
}

// A frame of the session, borrowed for the handler's call. `image` is the camera picture.
// `camera` is the camera's pose (camera to world, axes along the picture as the sensor gives
// it), `intrinsics` the picture's, `tracking` and `reason` how well it is tracked. Planes,
// anchors, image targets found and points are arrays of `*_count` items (planes, images and
// points only when the options asked for them); `light` and `depth` are set when asked for
// and available. `has_image` is false where the platform gives no camera picture (the web
// without WebXR raw camera access, where the browser draws the camera itself): `image` is
// then empty, with no planes, and only its size and rotation are set (the viewport's).
struct ArFrame {
    ArCameraImage image;
    ArMat4 camera;
    ArIntrinsics intrinsics;
    int tracking;
    int reason;
    *ArPlane planes;
    int plane_count;
    *ArAnchor anchors;
    int anchor_count;
    *ArPoint points;
    int point_count;
    ArLight light;
    ArDepth depth;
    *ArTrackedImage images;
    int image_count;
    *ArMesh meshes;
    int mesh_count;
    bool has_image;
    bool has_earth;
    ArEarth earth;
}

// The platform's side (native/ios, native/android, native/web). ar_native_session starts the
// session (`on` 1, with the option flags and the picture size wished for) or stops it;
// ar_native_images starts a new set of image targets (sent before the session call that uses
// them) and ar_native_image_add gives one, as tight 8-bit gray pixels or a file path, which
// the native side copies; ar_native_image_state says where one stands (an ArImageState).
// Status messages come on the "ar" channel ("running", "unsupported", "denied",
// "installing", "failed", "paused"), and "frame" on the "ar_frame" channel when a frame is
// waiting and none was posted since the last acquire. ar_native_frame_acquire lends the
// newest frame: it fills AR_IMAGE_INFO int64 values (ui-camera's frame layout) and
// AR_CAMERA_INFO doubles and returns 1, or 0 when there is none. While it is lent, the
// other calls read it; ar_native_frame_release ends the loan. Ids cross as doubles (exact to
// 2^53), so the web's JavaScript sees plain numbers.
extern void ar_native_session(int on, int flags, int width, int height);
extern int ar_native_frame_acquire(*int64 image, *double camera);
extern void ar_native_frame_release();
extern int ar_native_plane_count();
extern int ar_native_mesh_count();
extern void ar_native_mesh(int index, *double info);
extern int ar_native_plane(int index, *double info, *float polygon, int max_points);
extern int ar_native_anchor_count();
extern void ar_native_anchor(int index, *double info);
extern int ar_native_points(*float out, int max_points);
extern int ar_native_light(*double info);
extern int ar_native_depth(*int64 info);
extern void ar_native_depth_model(string path);
extern double ar_native_cloud_host(double anchor, int ttl_days);
extern double ar_native_cloud_resolve(string cloud_id);
extern double ar_native_earth_anchor(double lat, double lng, double alt, *float quaternion);
extern double ar_native_earth_resolve(int rooftop, double lat, double lng, double alt, *float quaternion);
extern int ar_native_job(double job, *double info, *char text, int capacity);
extern int ar_native_earth(*double info);
extern int ar_native_hit_test(*float ray, int targets, *double out, int max_hits);
extern double ar_native_anchor_add(*float pose, double plane);
extern void ar_native_anchor_remove(double id);
extern void ar_native_images(int count, int tracked);
extern void ar_native_image_add(int index, *uint8 gray, int width, int height, string path, double physical_width);
extern int ar_native_image_state(int index);
extern int ar_native_tracked_image_count();
extern void ar_native_tracked_image(int index, *double info);

// Option flags for ar_native_session.
const int AR_FLAG_HORIZONTAL = 1;
const int AR_FLAG_VERTICAL = 2;
const int AR_FLAG_LIGHT = 4;
const int AR_FLAG_DEPTH = 8;
const int AR_FLAG_PEOPLE = 128;
const int AR_FLAG_MESH = 256;
// A depth model may fill in the depth (ArOptions.depth_model), and it is used even where a
// sensor measures depth.
const int AR_FLAG_DEPTH_MODEL = 512;
const int AR_FLAG_DEPTH_MODEL_ONLY = 1024;
// ARCore's cloud anchors and Earth (Android).
const int AR_FLAG_CLOUD = 2048;
const int AR_FLAG_GEO = 4096;
// Values ar_native_mesh fills.
const int AR_MESH_INFO = 25;
const int AR_FLAG_POINTS = 16;
const int AR_FLAG_LIGHT_HDR = 32;
const int AR_FLAG_IMAGES = 64;

// How many values the native side fills. The image: width, height, format, plane_count,
// rotation, front, matrix, full_range, timestamp_ns, then for each of 3 planes its data
// pointer, row_stride, pixel_stride and size.
const int AR_IMAGE_INFO = 24;

// The camera: tracking (an ArTracking), reason (an ArReason), the pose's 16 values, fx, fy,
// cx, cy, and the intrinsics' image width and height.
const int AR_CAMERA_INFO = 24;

// A plane: id, alignment, tracking, the center pose's 16 values, extent x and z, subsumed
// by.
const int AR_PLANE_INFO = 23;

// An anchor: id, tracking, the pose's 16 values.
const int AR_ANCHOR_INFO = 18;

// The light: valid, intensity, temperature, color r g b, has_main, direction x y z,
// intensity r g b, has_harmonics, 27 harmonics coefficients, then the source (an
// ArLightSource). Intensity and color are the platform's own (ar_light_read scales them).
const int AR_LIGHT_INFO = 42;

// A hit: distance, kind, plane id, the pose's 16 values.
const int AR_HIT_INFO = 19;

// Depth: width, height, format, row_stride, data pointer, size, estimated.
const int AR_DEPTH_INFO = 7;

// A tracked image: id, target index, tracking, method, the pose's 16 values, extent x and z.
const int AR_TRACKED_IMAGE_INFO = 22;

// The most plane outline points, planes, feature points and hits read from one frame.
const int AR_MAX_POLYGON = 256;
const int AR_MAX_PLANES = 64;
const int AR_MAX_POINTS = 4096;
const int AR_MAX_HITS = 16;

// The most image targets a session takes (ARKit suggests up to 100 for detection; ARCore's
// database holds up to 1000) and the most read from one frame.
const int AR_MAX_IMAGES = 100;

// The flags for ar_native_session from the options.
int ar_flags(ArOptions options) {
    int flags = 0;
    if (options.horizontal) { flags |= AR_FLAG_HORIZONTAL; }
    if (options.vertical) { flags |= AR_FLAG_VERTICAL; }
    if (options.light) { flags |= AR_FLAG_LIGHT; }
    if (options.depth) { flags |= AR_FLAG_DEPTH; }
    if (options.people) { flags |= AR_FLAG_PEOPLE; }
    if (options.mesh) { flags |= AR_FLAG_MESH; }
    if (options.depth && options.depth_model != null && options.depth_model[0] != 0 && options.depth_source != ArDepthSourceSensor) {
        flags |= AR_FLAG_DEPTH_MODEL;
        if (options.depth_source == ArDepthSourceModel) { flags |= AR_FLAG_DEPTH_MODEL_ONLY; }
    }
    if (options.cloud_anchors) { flags |= AR_FLAG_CLOUD; }
    if (options.geospatial) { flags |= AR_FLAG_GEO; }
    if (options.points) { flags |= AR_FLAG_POINTS; }
    if (options.light_hdr) { flags |= AR_FLAG_LIGHT_HDR; }
    if (options.images != null && options.image_count > 0) { flags |= AR_FLAG_IMAGES; }
    return flags;
}

// A message on the "ar" channel as an ArStatus (ArFailed when it is not one).
int ar_read_status(string payload) {
    if (payload == null) { return ArFailed; }
    if (strcmp(payload, "running") == 0) { return ArRunning; }
    if (strcmp(payload, "starting") == 0) { return ArStarting; }
    if (strcmp(payload, "unsupported") == 0) { return ArUnsupported; }
    if (strcmp(payload, "denied") == 0) { return ArDenied; }
    if (strcmp(payload, "installing") == 0) { return ArInstalling; }
    if (strcmp(payload, "paused") == 0) { return ArPaused; }
    if (strcmp(payload, "tap") == 0) { return ArWaitingForTap; }
    return ArFailed;
}

// 16 doubles from `at` as a matrix.
ArMat4 ar_mat4_from(*double at) {
    ArMat4 m;
    for (i in 0..16) { m.m[i] = (float)at[i]; }
    return m;
}

// True when every value of `m` is finite (not NaN or infinite).
bool ar_mat4_finite(ArMat4 m) {
    for (i in 0..16) {
        float v = m.m[i];
        if (v != v || v > 1e30 || v < -1e30) { return false; }
    }
    return true;
}

// The image values the native side filled, checked, as a camera image; false when they do
// not describe one (unknown format, a missing plane, strides or sizes that do not cover the
// pixels), so a handler never reads outside a buffer. No planes at all is a frame with no
// picture (ArFrame.has_image false).
bool ar_image_read(*int64 info, *ArCameraImage out) {
    *out = ArCameraImage{};
    int64 width = info[0];
    int64 height = info[1];
    int64 format = info[2];
    if (width <= 0 || height <= 0 || width > 16384 || height > 16384) { return false; }
    if (format < 0 || format > 4) { return false; }
    out.width = (int)width;
    out.height = (int)height;
    out.format = (int)format;
    out.plane_count = (int)info[3];
    int64 rotation = info[4];
    if (rotation != 0 && rotation != 90 && rotation != 180 && rotation != 270) { return false; }
    out.rotation = (int)rotation;
    out.front = info[5] != 0;
    out.matrix = info[6] == 1 ? 1 : 0;
    out.full_range = info[7] != 0;
    out.timestamp_ns = info[8];
    // No picture (the web, where the browser draws the camera): no planes, only the size.
    if (out.plane_count == 0) { return true; }
    int want = format <= 1 ? 2 : format == 4 ? 1 : 3;
    if (out.plane_count != want) { return false; }
    for (i in 0..want) {
        *ArImagePlane plane = &out.planes[i];
        plane.data = (*uint8)info[9 + i * 4];
        int64 row_stride = info[10 + i * 4];
        int64 pixel_stride = info[11 + i * 4];
        plane.size = info[12 + i * 4];
        if (plane.data == null || row_stride <= 0 || row_stride > 1 << 20) { return false; }
        if (pixel_stride <= 0 || pixel_stride > 8) { return false; }
        plane.row_stride = (int)row_stride;
        plane.pixel_stride = (int)pixel_stride;
        int rows = out.height;
        int samples = out.width;
        if (i > 0) {
            rows = (out.height + 1) / 2;
            samples = (out.width + 1) / 2;
        }
        int tail = want == 2 && i == 1 ? 2 : format == 4 ? 4 : 1;
        if (want == 2 && i == 1 && plane.pixel_stride < 2) { return false; }
        if (format == 4 && plane.pixel_stride < 4) { return false; }
        int64 row_bytes = (int64)(samples - 1) * plane.pixel_stride + tail;
        if ((int64)plane.row_stride < row_bytes) { return false; }
        int64 need = (int64)(rows - 1) * plane.row_stride + row_bytes;
        if (plane.size < need) { return false; }
    }
    return true;
}

// The camera values the native side filled, checked, into the frame; false when the
// intrinsics do not describe an image or the pose is not a number.
bool ar_camera_read(*double info, *ArFrame out) {
    int tracking = (int)info[0];
    if (tracking < ArTrackingNone || tracking > ArTrackingNormal) { tracking = ArTrackingNone; }
    out.tracking = tracking;
    int reason = (int)info[1];
    if (reason < ArReasonNone || reason > ArReasonBadState) { reason = ArReasonBadState; }
    out.reason = reason;
    out.camera = ar_mat4_from(&info[2]);
    out.intrinsics = ArIntrinsics{(float)info[18], (float)info[19], (float)info[20], (float)info[21], (int)info[22], (int)info[23]};
    *ArIntrinsics k = &out.intrinsics;
    if (!(k.fx > 0.0) || !(k.fy > 0.0) || k.width <= 0 || k.height <= 0) { return false; }
    if (!ar_mat4_finite(out.camera)) { return false; }
    return true;
}

// The buffers a frame's planes, outlines, anchors and points are read into, reused from one
// frame to the next.
List<ArPlane> _ar_planes;
List<ArVec2> _ar_polygon;
List<ArAnchor> _ar_anchors;
List<ArPoint> _ar_points;
List<ArTrackedImage> _ar_tracked;
List<ArMesh> _ar_meshes;

// The image targets the session has, as ar_send_images last sent them: each one's name
// (copied), whether it was refused before reaching the platform, and what was sent, by
// ar_images_key.
List<String> _ar_image_names;
List<bool> _ar_image_refused;
int64 _ar_images_sent;

// Reads the lent frame's planes, anchors, points, light and depth into `frame`, as `flags`
// asked.
void ar_frame_fill(*ArFrame frame, int flags) {
    _ar_planes.clear();
    _ar_polygon.clear();
    _ar_anchors.clear();
    _ar_points.clear();
    _ar_tracked.clear();
    _ar_meshes.clear();
    double[AR_LIGHT_INFO] values;
    if ((flags & (AR_FLAG_HORIZONTAL | AR_FLAG_VERTICAL)) != 0) {
        int count = ar_native_plane_count();
        if (count > AR_MAX_PLANES) { count = AR_MAX_PLANES; }
        float[AR_MAX_POLYGON * 2] outline;
        List<int> starts;
        defer starts.free();
        for (i in 0..count) {
            int n = ar_native_plane(i, &values[0], &outline[0], AR_MAX_POLYGON);
            if (n < 0) { continue; }
            if (n > AR_MAX_POLYGON) { n = AR_MAX_POLYGON; }
            ArPlane plane = ArPlane{id: (int64)values[0], alignment: (int)values[1], tracking: (int)values[2]};
            plane.pose = ar_mat4_from(&values[3]);
            plane.extent_x = (float)values[19];
            plane.extent_z = (float)values[20];
            plane.subsumed_by = (int64)values[21];
            plane.classification = (int)values[22];
            if (plane.classification < ArPlaneNone || plane.classification > ArPlaneDoor) { plane.classification = ArPlaneNone; }
            if (plane.alignment < ArHorizontalUp || plane.alignment > ArVertical) { plane.alignment = ArHorizontalUp; }
            if (!ar_mat4_finite(plane.pose)) { continue; }
            plane.polygon_count = n;
            starts.push(_ar_polygon.size);
            for (p in 0..n) { _ar_polygon.push(ArVec2{outline[p * 2], outline[p * 2 + 1]}); }
            _ar_planes.push(plane);
        }
        // The outline buffer may have moved while it grew: point into it at the end.
        for (i in 0..(int)_ar_planes.size) { _ar_planes.data[i].polygon = &_ar_polygon.data[starts.data[i]]; }
    }
    int anchors = ar_native_anchor_count();
    for (i in 0..anchors) {
        ar_native_anchor(i, &values[0]);
        ArAnchor anchor = ArAnchor{id: (int64)values[0], tracking: (int)values[1], pose: ar_mat4_from(&values[2])};
        if (ar_mat4_finite(anchor.pose)) { _ar_anchors.push(anchor); }
    }
    if ((flags & AR_FLAG_POINTS) != 0) {
        _ar_points.resize(AR_MAX_POINTS);
        int n = ar_native_points((*float)&_ar_points.data[0], AR_MAX_POINTS);
        if (n < 0) { n = 0; }
        if (n > AR_MAX_POINTS) { n = AR_MAX_POINTS; }
        _ar_points.size = n;
    }
    if ((flags & AR_FLAG_IMAGES) != 0) {
        int count = ar_native_tracked_image_count();
        if (count > AR_MAX_IMAGES) { count = AR_MAX_IMAGES; }
        for (i in 0..count) {
            ar_native_tracked_image(i, &values[0]);
            ArTrackedImage image;
            if (ar_tracked_image_read(&values[0], &image)) { _ar_tracked.push(image); }
        }
    }
    frame.images = _ar_tracked.size > 0 ? &_ar_tracked.data[0] : null;
    frame.image_count = (int)_ar_tracked.size;
    if ((flags & AR_FLAG_MESH) != 0) {
        double[AR_MESH_INFO] mv;
        int count = ar_native_mesh_count();
        for (i in 0..count) {
            ar_native_mesh(i, &mv[0]);
            ArMesh m = ArMesh{id: (int64)mv[0], vertex_count: (int)mv[18], vertex_stride: (int)mv[19], normal_stride: (int)mv[21],
                face_count: (int)mv[23], index_bytes: (int)mv[24]};
            m.pose = ar_mat4_from(&mv[1]);
            m.vertices = (*uint8)(int64)mv[17];
            m.normals = (*uint8)(int64)mv[20];
            m.faces = (*uint8)(int64)mv[22];
            // a mesh the platform lent whole: data, sane strides and index sizes
            if (m.vertices == null || m.faces == null || m.vertex_count <= 0 || m.face_count <= 0 || m.vertex_stride < 12 ||
                (m.normals != null && m.normal_stride < 12) || (m.index_bytes != 2 && m.index_bytes != 4) ||
                !ar_mat4_finite(m.pose)) { continue; }
            _ar_meshes.push(m);
        }
    }
    frame.meshes = _ar_meshes.size > 0 ? &_ar_meshes.data[0] : null;
    frame.mesh_count = (int)_ar_meshes.size;
    frame.planes = _ar_planes.size > 0 ? &_ar_planes.data[0] : null;
    frame.plane_count = (int)_ar_planes.size;
    frame.anchors = _ar_anchors.size > 0 ? &_ar_anchors.data[0] : null;
    frame.anchor_count = (int)_ar_anchors.size;
    frame.points = _ar_points.size > 0 ? &_ar_points.data[0] : null;
    frame.point_count = (int)_ar_points.size;
    if ((flags & (AR_FLAG_LIGHT | AR_FLAG_LIGHT_HDR)) != 0 && ar_native_light(&values[0]) != 0) { ar_light_read(&values[0], &frame.light); }
    int64[AR_DEPTH_INFO] depth;
    if ((flags & (AR_FLAG_DEPTH | AR_FLAG_PEOPLE)) != 0 && ar_native_depth(&depth[0]) != 0) { ar_depth_read(&depth[0], &frame.depth); }
    double[14] earth;
    if ((flags & AR_FLAG_GEO) != 0 && ar_native_earth(&earth[0]) != 0) { frame.has_earth = ar_earth_read(&earth[0], &frame.earth); }
}

// The Earth values the native side filled, checked; false when they are not numbers.
bool ar_earth_read(*double info, *ArEarth out) {
    for (i in 0..14) {
        double v = info[i];
        if (v != v || v > 1e9 || v < -1e9) { return false; }
    }
    *out = ArEarth{state: (int)info[0], tracking: (int)info[1], latitude: info[2], longitude: info[3], altitude: info[4],
                   horizontal_accuracy: info[5], vertical_accuracy: info[6], yaw_accuracy: info[11]};
    for (k in 0..4) { out.rotation[k] = (float)info[7 + k]; }
    if (out.tracking < ArTrackingNone || out.tracking > ArTrackingNormal) { out.tracking = ArTrackingNone; }
    return true;
}

// --- cloud anchors and Earth (ARCore, Android) ---

// Where a job stands: still running, done, failed (`code` is ARCore's state for it: not
// authorized, not found, hosting failed...), or unknown (no such job, or not supported here).
enum ArJobState { ArJobRunning, ArJobDone, ArJobFailed, ArJobUnknown }

// A job's outcome: its state, ARCore's code when it failed, the anchor a resolve made (its id
// in frame.anchors) and the cloud anchor id a host got.
struct ArJob {
    int state;
    int code;
    int64 anchor;
    String cloud_id;
}

// Hosts an anchor (an id from ar_anchor_add) as a cloud anchor kept ttl_days (1 to 365); a
// job to follow with ar_job, or 0 when it cannot start (no session with cloud_anchors, an
// unknown anchor, or a platform without ARCore's cloud anchors).
int64 ar_host_cloud_anchor(int64 anchor, int ttl_days) {
    return (int64)ar_native_cloud_host((double)anchor, ttl_days);
}

// Resolves a cloud anchor id into an anchor of this session; a job, or 0.
int64 ar_resolve_cloud_anchor(string cloud_id) {
    return (int64)ar_native_cloud_resolve(cloud_id);
}

// An anchor at a place on Earth (WGS84 degrees, meters above the ellipsoid, an east-up-south
// quaternion); its id in frame.anchors, or 0 when Earth is not tracking.
int64 ar_earth_anchor(double lat, double lng, double alt, *float rotation) {
    return (int64)ar_native_earth_anchor(lat, lng, alt, rotation);
}

// An anchor `height` meters above the terrain at a place (ARCore finds the ground's
// altitude); a job, or 0.
int64 ar_terrain_anchor(double lat, double lng, double height, *float rotation) {
    return (int64)ar_native_earth_resolve(0, lat, lng, height, rotation);
}

// An anchor `height` meters above a building's rooftop at a place; a job, or 0.
int64 ar_rooftop_anchor(double lat, double lng, double height, *float rotation) {
    return (int64)ar_native_earth_resolve(1, lat, lng, height, rotation);
}

// Where a job stands into out (its cloud_id freed and filled again); a finished job is told
// once, then it is unknown.
int ar_job(int64 job, *ArJob out) {
    double[2] info;
    char[256] text;
    text[0] = 0;
    int state = ar_native_job((double)job, &info[0], &text[0], 256);
    if (state < ArJobRunning || state > ArJobUnknown) { state = ArJobUnknown; }
    out.state = state;
    out.code = (int)info[0];
    out.anchor = (int64)info[1];
    String_clear(&out.cloud_id);
    text[255] = 0;
    out.cloud_id.append((string)&text[0]);
    return state;
}

// The tracked-image values the native side filled, checked, as an ArTrackedImage with its
// target's name; false for an index the session does not have or a pose that is not a
// number.
bool ar_tracked_image_read(*double info, *ArTrackedImage out) {
    *out = ArTrackedImage{id: (int64)info[0], index: (int)info[1], tracking: (int)info[2], method: (int)info[3]};
    if (out.index < 0 || out.index >= (int)_ar_image_names.size) { return false; }
    out.name = _ar_image_names.data[out.index].data;
    if (out.name == null) { out.name = ""; }
    if (out.tracking < ArTrackingNone || out.tracking > ArTrackingNormal) { out.tracking = ArTrackingNone; }
    if (out.method < ArImageNotTracking || out.method > ArImageLastKnown) { out.method = ArImageNotTracking; }
    out.pose = ar_mat4_from(&info[4]);
    out.extent_x = (float)info[20];
    out.extent_z = (float)info[21];
    if (!(out.extent_x >= 0.0)) { out.extent_x = 0.0; }
    if (!(out.extent_z >= 0.0)) { out.extent_z = 0.0; }
    return ar_mat4_finite(out.pose);
}

// A target's pixels as tight 8-bit gray rows in `out` (RGBA to luma with BT.601's weights,
// as the platforms see it); false when the fields do not describe pixels (no data, a size
// out of 1 to 8192, an unknown format, a stride under a row).
bool ar_image_gray(*ArImageTarget target, List<uint8>* out) {
    out.clear();
    if (target.pixels == null || target.width <= 0 || target.height <= 0 || target.width > 8192 || target.height > 8192) { return false; }
    int texel = target.format == ArPixelsGray8 ? 1 : target.format == ArPixelsRGBA8 ? 4 : 0;
    if (texel == 0) { return false; }
    int64 stride = target.row_stride > 0 ? (int64)target.row_stride : (int64)target.width * texel;
    if (stride < (int64)target.width * texel) { return false; }
    out.resize((int64)target.width * target.height);
    for (y in 0..target.height) {
        *uint8 row = target.pixels + (int64)y * stride;
        *uint8 dst = &out.data[(int64)y * target.width];
        if (texel == 1) {
            for (x in 0..target.width) { dst[x] = row[x]; }
        } else {
            for (x in 0..target.width) {
                *uint8 p = row + x * 4;
                dst[x] = (uint8)((77 * (int)p[0] + 150 * (int)p[1] + 29 * (int)p[2] + 128) >> 8);
            }
        }
    }
    return true;
}

// What identifies a set of targets for ar_send_images: the array, the count and each
// target's fields and the characters of its name and path (not the pixels' contents).
int64 ar_images_key(*ArImageTarget images, int count) {
    uint64 h = 14695981039346656037;
    if (images == null || count <= 0) { return 0; }
    h = (h ^ (uint64)(int64)images) * 1099511628211;
    h = (h ^ (uint64)count) * 1099511628211;
    for (i in 0..count) {
        *ArImageTarget t = &images[i];
        h = (h ^ (uint64)(int64)t.pixels) * 1099511628211;
        h = (h ^ (uint64)((int64)t.width << 32 | (int64)t.height)) * 1099511628211;
        h = (h ^ (uint64)((int64)t.format << 32 | (int64)t.row_stride)) * 1099511628211;
        double w = (double)t.physical_width;
        h = (h ^ (uint64)(w * 1000000.0)) * 1099511628211;
        for (int64 k = 0; t.name != null && t.name[k] != 0; k++) { h = (h ^ (uint64)(uint8)t.name[k]) * 1099511628211; }
        h = (h ^ 255) * 1099511628211;
        for (int64 k = 0; t.path != null && t.path[k] != 0; k++) { h = (h ^ (uint64)(uint8)t.path[k]) * 1099511628211; }
    }
    return (int64)(h | 1);
}

// A target's file as a path the platform opens: an absolute path or (on the web) a URL as it
// is, else the app's asset of that name (ui_asset_path), else the path as given. The caller
// frees the result when `owned` comes back true.
string ar_image_path(string path, *bool owned) {
    *owned = false;
    if (path == null || path[0] == 0 || path[0] == '/' || strstr(path, "://") != null) { return path; }
    string found = ui_asset_path(path);
    if (found == null) { return path; }
    *owned = true;
    return found;
}

// Sends the depth model's path to the platform (resolved as an image target's path) when the
// options use one.
void ar_send_depth_model(ArOptions options) {
    if ((ar_flags(options) & AR_FLAG_DEPTH_MODEL) == 0) { return; }
    bool owned;
    string path = ar_image_path(options.depth_model, &owned);
    ar_native_depth_model(path);
    if (owned) { free((*void)path); }
}

// True when a and b name the same file (both null or empty, or equal).
bool ar_same_path(string a, string b) {
    bool ae = a == null || a[0] == 0;
    bool be = b == null || b[0] == 0;
    if (ae || be) { return ae && be; }
    return strcmp(a, b) == 0;
}

// Sends the targets to the platform (ar_native_images, then one ar_native_image_add each,
// up to AR_MAX_IMAGES) and keeps their names. A target with neither valid pixels nor a path,
// or no physical width, is refused here and reaches the platform empty.
void ar_send_images(*ArImageTarget images, int count, int tracked) {
    for (i in 0..(int)_ar_image_names.size) { String_free(&_ar_image_names.data[i]); }
    _ar_image_names.clear();
    _ar_image_refused.clear();
    if (images == null || count < 0) { count = 0; }
    if (count > AR_MAX_IMAGES) { count = AR_MAX_IMAGES; }
    if (tracked < 0) { tracked = 0; }
    ar_native_images(count, tracked);
    List<uint8> gray;
    defer gray.free();
    for (i in 0..count) {
        *ArImageTarget t = &images[i];
        String name;
        String_from(&name, t.name == null ? "" : t.name);
        _ar_image_names.push(name);
        bool has_pixels = ar_image_gray(t, &gray);
        bool has_path = !has_pixels && t.path != null && t.path[0] != 0;
        bool ok = (has_pixels || has_path) && t.physical_width > 0.0 && t.physical_width < 1000.0;
        _ar_image_refused.push(!ok);
        if (!ok) {
            ar_native_image_add(i, null, 0, 0, null, 0.0);
            continue;
        }
        if (has_pixels) {
            ar_native_image_add(i, &gray.data[0], t.width, t.height, null, (double)t.physical_width);
        } else {
            bool owned;
            string path = ar_image_path(t.path, &owned);
            ar_native_image_add(i, null, 0, 0, path, (double)t.physical_width);
            if (owned) { free(path); }
        }
    }
    _ar_images_sent = ar_images_key(images, count);
}

// Where image target `index` (of ArOptions.images) stands: an ArImageState. Pending while
// the platform prepares it (ARKit checks each image first; ARCore when the session starts).
int ar_image_state(int index) {
    if (index < 0 || index >= (int)_ar_image_refused.size) { return ArImageRejected; }
    if (_ar_image_refused.data[index]) { return ArImageRejected; }
    int state = ar_native_image_state(index);
    if (state < ArImagePending || state > ArImageRejected) { return ArImagePending; }
    return state;
}

// The light values the native side filled, as an ArLight on the package's scale: ARKit's
// lumens over 1000 and its temperature as a color, ARCore's gamma pixel intensity and color
// correction in linear space (ar_light_from_arkit, ar_light_from_arcore).
void ar_light_read(*double info, *ArLight out) {
    *out = ArLight{};
    out.valid = info[0] != 0.0;
    double raw = info[1];
    out.raw_intensity = (float)raw;
    out.temperature = (float)info[2];
    out.color = ArVec3{(float)info[3], (float)info[4], (float)info[5]};
    out.has_main = info[6] != 0.0;
    out.main_direction = ArVec3{(float)info[7], (float)info[8], (float)info[9]};
    out.main_intensity = ArVec3{(float)info[10], (float)info[11], (float)info[12]};
    out.has_harmonics = info[13] != 0.0;
    for (i in 0..27) { out.harmonics[i] = (float)info[14 + i]; }
    int source = (int)info[41];
    if (source < ArLightNone || source > ArLightWebXR) { source = ArLightNone; }
    out.source = source;
    out.intensity = (float)raw;
    if (source == ArLightARKit) {
        out.intensity = ar_light_from_arkit(raw);
        out.color = ar_temperature_rgb(out.temperature > 0.0 ? out.temperature : 6500.0);
    } else if (source == ArLightARCore) {
        out.intensity = ar_light_from_arcore(raw);
        out.color = ArVec3{ar_gamma_to_linear((double)out.color.x), ar_gamma_to_linear((double)out.color.y), ar_gamma_to_linear((double)out.color.z)};
    } else if (source == ArLightARCoreHdr || source == ArLightWebXR) {
        out.intensity = 1.0;
        out.color = ArVec3{1.0, 1.0, 1.0};
    }
    if (out.temperature <= 0.0) { out.temperature = 6500.0; }
    if (!(out.intensity >= 0.0) || out.intensity > 1e6) { out.intensity = 0.0; }
}

// The depth values the native side filled, checked, as an ArDepth; left empty when they do
// not describe a depth image.
void ar_depth_read(*int64 info, *ArDepth out) {
    *out = ArDepth{};
    int64 width = info[0];
    int64 height = info[1];
    int64 format = info[2];
    int64 row = info[3];
    *uint8 data = (*uint8)info[4];
    int64 size = info[5];
    if (width <= 0 || height <= 0 || width > 8192 || height > 8192 || data == null) { return; }
    if (format != ArDepthMeters32 && format != ArDepthMillimeters16) { return; }
    int64 texel = format == ArDepthMeters32 ? 4 : 2;
    if (row < width * texel || size < (height - 1) * row + width * texel) { return; }
    *out = ArDepth{width: (int)width, height: (int)height, format: (int)format, row_stride: (int)row, data: data, size: size,
                   estimated: info[6] != 0};
}

// The depth at pixel (x, y) of the depth image in meters; 0 outside it or where unknown.
float ArDepth_meters(*ArDepth self, int x, int y) {
    if (self.data == null || x < 0 || y < 0 || x >= self.width || y >= self.height) { return 0.0; }
    *uint8 row = self.data + (int64)y * self.row_stride;
    if (self.format == ArDepthMeters32) {
        float v = ((*float)row)[x];
        return v == v ? v : 0.0;
    }
    return (float)((*uint16)row)[x] / 1000.0;
}

// The world point the depth image sees at pixel (u, v) of the picture (as the sensor gives
// it), and false where the depth is unknown.
bool _ar_depth_point(*ArFrame self, double u, double v, *ArVec3 out) {
    *ArIntrinsics k = &self.intrinsics;
    int dx = (int)(u * (double)self.depth.width / (double)k.width);
    int dy = (int)(v * (double)self.depth.height / (double)k.height);
    float d = self.depth.meters(dx, dy);
    if (!(d > 0.0)) { return false; }
    ArVec3 c = ArVec3{(float)((u - (double)k.cx) / (double)k.fx * (double)d), (float)(-(v - (double)k.cy) / (double)k.fy * (double)d), -d};
    *out = ar_mat4_point(self.camera, c);
    return true;
}

// Hit-tests the depth image under the point (x, y) of a viewport `width` x `height`, as
// ViroReact's depth hit tests: the real surface there, planes found or not (a sofa, a
// person, a step). On a hit, `out` gets its distance, AR_HIT_DEPTH, plane 0 and a pose at
// the point with y along the surface's normal (from the depth around it, toward the camera).
// False without depth (ArOptions.depth) or where the depth is unknown.
bool ArFrame_depth_hit(*ArFrame self, float x, float y, float width, float height, *ArHit out) {
    if (self.depth.data == null || !(self.intrinsics.fx > 0.0) || !(width > 0.0) || !(height > 0.0)) { return false; }
    ArVec2 p = self.intrinsics.view_to_image(self.image.rotation, (double)width, (double)height, (double)x, (double)y);
    ArVec3 at;
    if (!_ar_depth_point(self, (double)p.x, (double)p.y, &at)) { return false; }
    // the normal from the neighbouring depth pixels
    double step = (double)self.intrinsics.width / (double)self.depth.width;
    ArVec3 l;
    ArVec3 r;
    ArVec3 u;
    ArVec3 dn;
    ArVec3 n = ArVec3{0.0, 1.0, 0.0};
    if (_ar_depth_point(self, (double)p.x - step, (double)p.y, &l) && _ar_depth_point(self, (double)p.x + step, (double)p.y, &r) &&
        _ar_depth_point(self, (double)p.x, (double)p.y - step, &u) && _ar_depth_point(self, (double)p.x, (double)p.y + step, &dn)) {
        ArVec3 a = ArVec3{r.x - l.x, r.y - l.y, r.z - l.z};
        ArVec3 b = ArVec3{dn.x - u.x, dn.y - u.y, dn.z - u.z};
        ArVec3 c = ArVec3{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x};
        float len = (float)sqrt((double)(c.x * c.x + c.y * c.y + c.z * c.z));
        if (len > 1e-9) { n = ArVec3{c.x / len, c.y / len, c.z / len}; }
    }
    ArVec3 eye = ar_mat4_position(self.camera);
    ArVec3 to = ArVec3{eye.x - at.x, eye.y - at.y, eye.z - at.z};
    if (n.x * to.x + n.y * to.y + n.z * to.z < 0.0) { n = ArVec3{-n.x, -n.y, -n.z}; }
    // x across the normal (level when it can be), z = x cross y
    ArVec3 side = n.y > 0.99 || n.y < -0.99 ? ArVec3{1.0, 0.0, 0.0} : ArVec3{0.0, 1.0, 0.0};
    ArVec3 xa = ArVec3{side.y * n.z - side.z * n.y, side.z * n.x - side.x * n.z, side.x * n.y - side.y * n.x};
    float xl = (float)sqrt((double)(xa.x * xa.x + xa.y * xa.y + xa.z * xa.z));
    xa = ArVec3{xa.x / xl, xa.y / xl, xa.z / xl};
    ArVec3 za = ArVec3{xa.y * n.z - xa.z * n.y, xa.z * n.x - xa.x * n.z, xa.x * n.y - xa.y * n.x};
    ArMat4 pose = ar_mat4_identity();
    pose.m[0] = xa.x; pose.m[1] = xa.y; pose.m[2] = xa.z;
    pose.m[4] = n.x; pose.m[5] = n.y; pose.m[6] = n.z;
    pose.m[8] = za.x; pose.m[9] = za.y; pose.m[10] = za.z;
    pose.m[12] = at.x; pose.m[13] = at.y; pose.m[14] = at.z;
    float dist = (float)sqrt((double)(to.x * to.x + to.y * to.y + to.z * to.z));
    *out = ArHit{distance: dist, kind: AR_HIT_DEPTH, plane: 0, pose: pose};
    return true;
}

// The view matrix (world to camera) for the screen: x right and y up as the picture shows
// once turned upright.
ArMat4 ArFrame_view(*ArFrame self) { return ar_view_matrix(self.camera, self.image.rotation); }

// The projection for a viewport `width` x `height` that the picture covers (eskiu-gpu's
// GPU_YUV_COVER), depth from 0 at `near` to 1 at `far`.
ArMat4 ArFrame_projection(*ArFrame self, float width, float height, float near, float far) {
    return self.intrinsics.projection(self.image.rotation, (double)width, (double)height, (double)near, (double)far);
}

// The display transform for a viewport `width` x `height`: normalized viewport coordinates
// (0 to 1 from the top left) to normalized coordinates of the picture as stored.
ArAffine ArFrame_display_transform(*ArFrame self, float width, float height) {
    return self.intrinsics.display_transform(self.image.rotation, (double)width, (double)height);
}

// The ray from the camera through the point (x, y) of a viewport `width` x `height` (from
// the top left) that the picture covers.
ArRay ArFrame_ray(*ArFrame self, float x, float y, float width, float height) {
    return self.intrinsics.ray(self.camera, self.image.rotation, (double)width, (double)height, (double)x, (double)y);
}

// Hit-tests the world under the point (x, y) of a viewport `width` x `height` against
// `targets` (AR_HIT_PLANES, AR_HIT_ESTIMATED, or both), nearest first. Writes up to `max`
// results to `out` and returns how many. Call it in the frame handler.
int ArFrame_hit_test(*ArFrame self, float x, float y, float width, float height, int targets, *ArHit out, int max) {
    // Before the first picture the intrinsics are zero, and a viewport may be empty: no ray.
    if (!(width > 0.0) || !(height > 0.0) || !(self.intrinsics.fx > 0.0) || !(self.intrinsics.fy > 0.0)) { return 0; }
    ArRay ray = self.ray(x, y, width, height);
    return ar_hit_test_ray(ray, targets, out, max);
}

// Hit-tests the world along a ray in world space (see ArFrame_hit_test).
int ar_hit_test_ray(ArRay ray, int targets, *ArHit out, int max) {
    float[6] r = {ray.origin.x, ray.origin.y, ray.origin.z, ray.direction.x, ray.direction.y, ray.direction.z};
    double[AR_HIT_INFO * AR_MAX_HITS] values;
    if (max > AR_MAX_HITS) { max = AR_MAX_HITS; }
    if (max <= 0) { return 0; }
    // A ray with a non-finite part or no direction hits nothing (ARKit raises on one).
    double len2 = (double)(ray.direction.x * ray.direction.x + ray.direction.y * ray.direction.y + ray.direction.z * ray.direction.z);
    for (k in 0..6) { if (!(r[k] - r[k] == 0.0)) { return 0; } }
    if (!(len2 > 1e-12)) { return 0; }
    int n = ar_native_hit_test(&r[0], targets, &values[0], max);
    if (n < 0) { n = 0; }
    if (n > max) { n = max; }
    int kept = 0;
    for (i in 0..n) {
        *double v = &values[i * AR_HIT_INFO];
        ArHit hit = ArHit{distance: (float)v[0], kind: (int)v[1], plane: (int64)v[2], pose: ar_mat4_from(&v[3])};
        if (!ar_mat4_finite(hit.pose)) { continue; }
        out[kept] = hit;
        kept++;
    }
    return kept;
}

// Adds an anchor at `pose` (world space); returns its id, or 0 when the session is not
// running. Its pose follows the world as tracking improves (frame.anchors).
int64 ar_anchor_add(ArMat4 pose) { return (int64)ar_native_anchor_add(&pose.m[0], 0.0); }

// Adds an anchor at a hit; on Android one on a plane is attached to the plane, so it moves
// with it. Returns its id, or 0.
int64 ar_anchor_add_hit(*ArHit hit) { return (int64)ar_native_anchor_add(&hit.pose.m[0], (double)hit.plane); }

// Removes the anchor `id`; it is gone from the next frame.
void ar_anchor_remove(int64 id) { ar_native_anchor_remove((double)id); }

// The latest render's frame handler and the options it asked for, kept in the hook's slot.
struct ArSessionHandler { fn(*ArFrame)->void handler; ArOptions options; bool asked; int64 images_key; }

// How many use_ar_session scopes are mounted, and the flags the first asked for.
int ar_session_users;
int ar_session_flags;

// Frees a frame handler's closure; use_ar_session calls it when it replaces or drops it.
void ar_release_handler(escaping fn(*ArFrame)->void handler) { free_closure(handler); }

// Borrows the newest frame from the platform, hands it to `handler` and gives it back.
void ar_deliver_frame(fn(*ArFrame)->void handler) {
    int64[AR_IMAGE_INFO] image;
    double[AR_CAMERA_INFO] camera;
    if (ar_native_frame_acquire(&image[0], &camera[0]) == 0) { return; }
    ArFrame frame;
    if (ar_image_read(&image[0], &frame.image) && ar_camera_read(&camera[0], &frame)) {
        frame.has_image = frame.image.plane_count > 0;
        ar_frame_fill(&frame, ar_session_flags);
        handler(&frame);
    }
    ar_native_frame_release();
}

// Runs a world-tracking session while the scope is mounted, and hands `on_frame` each new
// frame on the UI thread, borrowed for the call (copy what you keep). A frame that arrives
// while it runs replaces the one waiting: a slow handler gets fewer, newer frames. New
// options start the session again with them. One session runs at a time; mount one per
// screen.
void use_ar_session(ArOptions options, escaping fn(*ArFrame)->void on_frame) {
    static int tag;
    *Slot slot = ui_slot(10, &tag);
    *ArSessionHandler held = (*ArSessionHandler)slot.data;
    if (held == null) {
        held = alloc<ArSessionHandler>(1);
        slot.data = held;
        slot.dispose = void() { ar_release_handler(held.handler); free(held); };
    } else { ar_release_handler(held.handler); }
    held.handler = on_frame;
    int flags = ar_flags(options);
    int64 images = ar_images_key(options.images, options.image_count);
    bool new_images = images != held.images_key || options.tracked_images != held.options.tracked_images;
    if (held.asked && (flags != ar_flags(held.options) || held.options.image_width != options.image_width ||
                       held.options.image_height != options.image_height || new_images ||
                       !ar_same_path(held.options.depth_model, options.depth_model))) {
        ar_send_depth_model(options);
        if (new_images) { ar_send_images(options.images, options.image_count, options.tracked_images); }
        ar_session_flags = flags;
        ar_native_session(1, flags, options.image_width, options.image_height);
    } else if (!held.asked && new_images) {
        ar_send_images(options.images, options.image_count, options.tracked_images);
    }
    held.images_key = images;
    held.options = options;
    use_native_event("ar_frame", void(string payload) { ar_deliver_frame(held.handler); });
    use_mount(void() {
        ar_session_users++;
        held.asked = true;
        ar_session_flags = ar_flags(held.options);
        ar_send_depth_model(held.options);
        ar_native_session(1, ar_session_flags, held.options.image_width, held.options.image_height);
    }, void() {
        ar_session_users--;
        if (ar_session_users == 0) { ar_native_session(0, 0, 0, 0); }
    });
}

// The latest render's status handler, kept in the hook's slot.
struct ArStatusHandler { fn(int)->void handler; }

// The last status the platform reported (an ArStatus).
int ar_last_status = ArStarting;

// Frees a status handler's closure; use_ar_status calls it when it replaces or drops it.
void ar_release_status_handler(escaping fn(int)->void handler) { free_closure(handler); }

// `on_status` gets each ArStatus the session reports while the scope is mounted: running,
// or why there is no AR (unsupported, denied, installing, failed, paused).
void use_ar_status(escaping fn(int)->void on_status) {
    static int tag;
    *Slot slot = ui_slot(10, &tag);
    *ArStatusHandler held = (*ArStatusHandler)slot.data;
    if (held == null) {
        held = alloc<ArStatusHandler>(1);
        slot.data = held;
        slot.dispose = void() { ar_release_status_handler(held.handler); free(held); };
    } else { ar_release_status_handler(held.handler); }
    held.handler = on_status;
    use_native_event("ar", void(string payload) {
        ar_last_status = ar_read_status(payload);
        held.handler(ar_last_status);
    });
}
